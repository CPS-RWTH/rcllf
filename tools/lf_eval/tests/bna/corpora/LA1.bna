# Expectations below were derived by hand.
# LA1 late anchor: an anchor at W[0] ends REJECTED(late) and nothing else.
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=500
admit 0 100 1:a:1 @101
admit 0 100 1:a:2 @102
close shutdown @150
expect D 1:a:2 REJECTED(late) @102
expect D 1:a:1 REJECTED(shutdown) @150
