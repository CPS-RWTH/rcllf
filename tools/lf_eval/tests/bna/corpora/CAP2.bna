# Expectations below were derived by hand.
# CAP2 the newcomer is the victim when it is the oldest (admitted within lateness).
params epoch=1 delta=10 lateness=0,50 capacity=8,2 retention=1000 timeout=500
admit 1 100 1:b:1 @101
admit 1 110 1:b:2 @111
admit 1 90 1:b:3 @121
close shutdown @200
expect S 1:b:3 OVERFLOW @121
expect S 1:b:1 FLUSHED @200
expect S 1:b:2 FLUSHED @200
