# Expectations below were derived by hand.
# CA1 cancellation, then a second close that changes nothing.
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=500
admit 0 100 1:a:1 @101
admit 0 110 1:a:2 @111
close cancelled @130
close shutdown @140
expect D 1:a:1 REJECTED(cancelled) @130
expect D 1:a:2 REJECTED(cancelled) @130
