# Expectations below were derived by hand.
# W2 a sample exactly at the watermark is late: W[1] = 100 - 10 = 90.
params epoch=1 delta=10 lateness=0,10 capacity=8,8 retention=1000 timeout=500
admit 1 100 1:b:1 @101
admit 1 90 1:b:2 @102
close shutdown @150
expect S 1:b:2 LATE @102
expect S 1:b:1 FLUSHED @150
