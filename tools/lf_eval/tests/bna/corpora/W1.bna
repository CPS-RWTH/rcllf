# Expectations below were derived by hand.
# W1 strict watermark: input 1 reaches W[1] = s(a) + delta exactly, so the anchor is
# never complete and times out at (101 + 47, 0).
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=47
admit 0 100 1:a:1 @101
admit 1 105 1:b:1 @106
admit 1 110 1:b:2 @111
admit 0 140 1:a:2 @141
wake @148
close shutdown @300
expect D 1:a:1 REJECTED(timeout) @148
expect S 1:b:1 SUPERSEDED @148
expect S 1:b:2 SUPERSEDED @148
expect D 1:a:2 REJECTED(timeout) @188
