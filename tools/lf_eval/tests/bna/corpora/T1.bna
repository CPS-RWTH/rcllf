# Expectations below were derived by hand.
# T1 tie on skew: anchor 100, candidates 95 and 105, the earlier stamp wins.
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=500
admit 1 95 1:b:1 @96
admit 0 100 1:a:1 @101
admit 1 105 1:b:2 @106
admit 1 120 1:b:3 @121
admit 0 130 1:a:2 @131
close shutdown @200
expect D 1:a:1 MATCHED 1:b:1 @131
expect S 1:b:1 SELECTED @131
expect S 1:b:2 SUPERSEDED @131
expect D 1:a:2 REJECTED(shutdown) @200
expect S 1:b:3 FLUSHED @200
