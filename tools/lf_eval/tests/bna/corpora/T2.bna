# Expectations below were derived by hand.
# T2 tie on stamp: two candidates at 98 from writers c and b, the smaller key (b) wins.
params epoch=1 delta=10 lateness=0,5 capacity=8,8 retention=1000 timeout=500
admit 1 98 1:c:1 @99
admit 1 98 1:b:1 @99+1
admit 0 100 1:a:1 @101
admit 1 120 1:c:2 @121
admit 0 130 1:a:2 @131
close shutdown @200
expect D 1:a:1 MATCHED 1:b:1 @131
expect S 1:b:1 SELECTED @131
expect S 1:c:1 SUPERSEDED @131
expect D 1:a:2 REJECTED(shutdown) @200
expect S 1:c:2 FLUSHED @200
