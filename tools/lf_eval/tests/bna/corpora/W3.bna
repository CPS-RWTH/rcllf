# Expectations below were derived by hand.
# W3 out of order within lateness: 98 arrives after 115 with lateness 20 and is selected.
params epoch=1 delta=10 lateness=0,20 capacity=8,8 retention=1000 timeout=500
admit 0 100 1:a:1 @101
admit 1 115 1:b:1 @116
admit 1 98 1:b:2 @117
admit 0 130 1:a:2 @131
admit 1 140 1:b:3 @141
close shutdown @200
expect D 1:a:1 MATCHED 1:b:2 @141
expect S 1:b:2 SELECTED @141
expect S 1:b:1 SUPERSEDED @141
expect D 1:a:2 REJECTED(shutdown) @200
expect S 1:b:3 FLUSHED @200
