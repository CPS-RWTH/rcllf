# Expectations below were derived by hand.
# SUP1 supersede: 50 + delta is below the least undecided anchor (100), 95 is not.
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=500
admit 0 100 1:a:1 @101
admit 1 50 1:b:1 @102
admit 1 95 1:b:2 @103
close shutdown @150
expect S 1:b:1 SUPERSEDED @102
expect D 1:a:1 REJECTED(shutdown) @150
expect S 1:b:2 FLUSHED @150
