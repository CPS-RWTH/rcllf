# Expectations below were derived by hand.
# SH1 shutdown close, then admissions after close.
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=500
admit 0 100 1:a:1 @101
admit 1 130 1:b:1 @131
close shutdown @140
admit 0 150 1:a:2 @150
admit 1 150 1:b:2 @151
expect D 1:a:1 REJECTED(shutdown) @140
expect S 1:b:1 FLUSHED @140
expect D 1:a:2 REJECTED(closed) @150
expect S 1:b:2 FAULT(closed) @151
