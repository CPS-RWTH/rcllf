# Expectations below were derived by hand.
# N1 normal: anchors every 30 ms, input 1 every 50 ms, delta 10, admitted 1 ms after the stamp.
# Anchor 60 has its only candidate (50) at exactly delta.
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=200
admit 0 0 1:a:1 @1
admit 1 0 1:b:1 @1
admit 0 30 1:a:2 @31
admit 1 50 1:b:2 @51
admit 0 60 1:a:3 @61
admit 0 90 1:a:4 @91
admit 1 100 1:b:3 @101
admit 0 120 1:a:5 @121
admit 0 150 1:a:6 @151
admit 1 150 1:b:4 @151
close shutdown @180
expect D 1:a:1 MATCHED 1:b:1 @51
expect S 1:b:1 SELECTED @51
expect D 1:a:2 REJECTED(missing) @61
expect D 1:a:3 MATCHED 1:b:2 @101
expect S 1:b:2 SELECTED @101
expect D 1:a:4 MATCHED 1:b:3 @151
expect S 1:b:3 SELECTED @151
expect D 1:a:5 REJECTED(missing) @151
expect D 1:a:6 REJECTED(shutdown) @180
expect S 1:b:4 FLUSHED @180
