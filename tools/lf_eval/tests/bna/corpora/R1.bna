# Expectations below were derived by hand.
# R1 no reuse: anchors 100 and 105 share the only candidate 103, the first takes it.
params epoch=1 delta=10 lateness=0,0 capacity=8,8 retention=1000 timeout=500
admit 0 100 1:a:1 @101
admit 1 103 1:b:1 @104
admit 0 105 1:a:2 @106
admit 1 130 1:b:2 @131
admit 0 140 1:a:3 @141
close shutdown @200
expect D 1:a:1 MATCHED 1:b:1 @141
expect S 1:b:1 SELECTED @141
expect D 1:a:2 REJECTED(missing) @141
expect D 1:a:3 REJECTED(shutdown) @200
expect S 1:b:2 FLUSHED @200
