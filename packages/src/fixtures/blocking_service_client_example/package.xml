<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>blocking_service_client_example</name>
  <version>0.1.2</version>
  <description>Demonstrates blocking service client patterns (spin_until_future_complete and future.wait)</description>
  <maintainer email="harun.teper@cps.rwth-aachen.de">Harun Teper</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>custom_interfaces</depend>

  <exec_depend>service_example</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
