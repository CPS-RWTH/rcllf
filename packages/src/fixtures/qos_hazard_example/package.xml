<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qos_hazard_example</name>
  <version>0.1.2</version>
  <description>
    QoS hazard fixture: best_effort, SensorDataQoS, depth-1, and a
    message_filters include, for exercising RCLLF-H000..H003 detection
    through libclang (Phase 5 slice B).
  </description>
  <maintainer email="harun.teper@cps.rwth-aachen.de">Harun Teper</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>custom_interfaces</depend>
  <depend>message_filters</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
