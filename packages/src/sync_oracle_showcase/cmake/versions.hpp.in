#ifndef SYNC_ORACLE_SHOWCASE__VERSIONS_HPP_
#define SYNC_ORACLE_SHOWCASE__VERSIONS_HPP_

// Generated by CMake (cmake/versions.hpp.in) from dpkg-query at configure
// time. ExactTime and ApproximateTime are header templates, so the version
// the package was compiled against is the version of the code that runs.

namespace sync_oracle_showcase
{
inline constexpr const char * kMessageFiltersVersion = "@SYNC_MF_VERSION@";
inline constexpr const char * kRclcppVersion = "@SYNC_RCLCPP_VERSION@";
}  // namespace sync_oracle_showcase

#endif  // SYNC_ORACLE_SHOWCASE__VERSIONS_HPP_
