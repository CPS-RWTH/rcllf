<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
    schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rcllf_message_filters</name>
  <version>0.1.1</version>
  <description>
    message_filters policies for rcllf. Holds the Bounded Nearest-to-Anchor
    (BNA) synchronizer: a pure decision engine, a replay tool for checking it
    against the Python oracle, and a message_filters policy.
  </description>
  <maintainer email="harun.teper@cps.rwth-aachen.de">Harun Teper</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>message_filters</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>geometry_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
