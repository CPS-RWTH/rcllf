<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
    schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_lf_binding</name>
  <version>0.1.1</version>
  <description>
    Binding library that connects lfc-compiled Lingua Franca reactors to ROS2
    component nodes. Replaces lf_reactor_bridge.c with a real runtime:
    component loading, LF time source, and reaction dispatch keyed by RID.
  </description>
  <maintainer email="harun.teper@cps.rwth-aachen.de">Harun Teper</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rcl</depend>
  <depend>tracetools</depend>
  <depend>composition_interfaces</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>rosgraph_msgs</depend>
  <depend>ros2_lf_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rcl_lifecycle</depend>
  <depend>rcl_interfaces</depend>
  <depend>type_description_interfaces</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>example_interfaces</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>rclcpp_lifecycle</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>tf2_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
